{
  "name": "@depositguard/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "provision:demo-users": "tsx src/scripts/provision-demo-users.ts",
    "demo:maturity-scenario": "tsx src/scripts/run-maturity-scenario.ts",
    "test": "tsx --test test/models.test.ts test/security.test.ts test/fdr-documents.test.ts test/workflows.test.ts test/dashboard-metrics.test.ts test/critical-scenarios.test.ts test/verification.test.ts test/api-availability.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "mongoose": "^8.9.3",
"nodemailer": "^10.2.1",
"pdfjs-dist": "^4.10.38",
"tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2"
  }
}
