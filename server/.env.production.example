# Configure these values in the hosting provider's secret/configuration manager.
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://<your-client-host>
MONGODB_URI=<managed-secret>
SESSION_SECRET=<managed-secret-at-least-32-characters>
SMTP_USER=
SMTP_APP_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible endpoint (for example https://api.groq.com/openai/v1).
# Set OPENAI_MODEL to a model supported by that provider. Keys stay server-side.
# OPENAI_BASE_URL=https://api.openai.com/v1
